<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fitkal.Views.LoginPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>

        <Image Source="arka_plan.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView>
            <VerticalStackLayout Padding="30,60,30,30" Spacing="0">

                <Image Source="fitkal_logo.png"
                       HeightRequest="280"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20"/>

                <Label Text="HOŞ GELDİNİZ!"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       Margin="0,10,0,50"/>

                <Label Text="KULLANICI ADI"
                       TextColor="#3b82f6"
                       FontAttributes="Bold"
                       FontSize="14"
                       Margin="5,0,0,5"/>

                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        HeightRequest="50"
                        Padding="15,0"
                        Margin="0,0,0,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Entry x:Name="EntKullanici"
                           Placeholder=""
                           TextColor="Black"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"/>
                </Border>

                <Label Text="ŞİFRE"
                       TextColor="#3b82f6"
                       FontAttributes="Bold"
                       FontSize="14"
                       Margin="5,0,0,5"/>

                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        HeightRequest="50"
                        Padding="15,0"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Entry x:Name="EntSifre"
                           Placeholder=""
                           IsPassword="True"
                           TextColor="Black"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"/>
                </Border>

                <HorizontalStackLayout Spacing="10" Margin="5,0,0,30">
                    <CheckBox x:Name="ChkBeniHatirla"
                              Color="#3b82f6"
                              VerticalOptions="Center"/>

                    <Label Text="Beni Hatırla"
                           TextColor="#8b95a8"
                           VerticalOptions="Center"
                           FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBeniHatirlaTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Button Text="GİRİŞ"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        BackgroundColor="#08204B"
                        BorderColor="#3b82f6"
                        BorderWidth="1.5"
                        CornerRadius="8"
                        HeightRequest="50"
                        Margin="40,0,40,15"
                        Clicked="OnGirisClicked"/>

                <Button Text="ÜYE OL"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        BackgroundColor="#08204B"
                        BorderColor="#3b82f6"
                        BorderWidth="1.5"
                        CornerRadius="8"
                        HeightRequest="50"
                        Margin="40,0,40,20"
                        Clicked="OnUyeOlClicked"/>

                <Label Text="ŞİFREMİ UNUTTUM"
                       TextColor="#8b95a8"
                       TextDecorations="Underline"
                       FontAttributes="Bold"
                       FontSize="13"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSifremiUnuttumTapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>