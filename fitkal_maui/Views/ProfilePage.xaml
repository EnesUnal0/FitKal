<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:fitkal.Views"
             x:Class="fitkal.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="arka_plan.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="75, *">
            <local:HeaderView Grid.Row="0" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="30,20" Spacing="15">

                    <VerticalStackLayout Spacing="2" Margin="0,0,0,10">
                        <Label x:Name="LblAdSoyadUst"
                               Text="Kullanıcı"
                               TextColor="White"
                               FontSize="28"
                               FontAttributes="Bold"/>

                        <Label x:Name="LblAltBilgi"
                               Text="-- kg, -- cm"
                               TextColor="#A0C0F0"
                               FontSize="16"/>

                        <Label x:Name="LblHedefKiloUst"
                               Text="Hedef Kg : --"
                               TextColor="#F9CA1C"
                               FontSize="16"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="AD"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry x:Name="EntAd"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="SOYAD"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry x:Name="EntSoyad"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="DOĞUM TARİHİ"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <DatePicker x:Name="DpDogumTarihi"
                                        TextColor="Black"
                                        Format="dd/MM/yyyy"
                                        VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="KİLO (kg)"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry x:Name="EntKilo"
                                   Keyboard="Numeric"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="BOY (cm)"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry x:Name="EntBoy"
                                   Keyboard="Numeric"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="HEDEF KİLO"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry x:Name="EntHedefKilo"
                                   Keyboard="Numeric"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="HEDEF KALORİ"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry x:Name="EntHedefKalori"
                                   Keyboard="Numeric"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="AKTİVİTE SEVİYESİ"
                               TextColor="#3b82f6"
                               FontAttributes="Bold"
                               FontSize="14"
                               Margin="5,0"/>

                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Picker x:Name="PickerAktiviteSeviyesi"
                                    Title="Seçiniz..."
                                    TitleColor="Gray"
                                    TextColor="Black"
                                    VerticalOptions="Center">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Hareketsiz (Masa başı iş)</x:String>
                                        <x:String>Hafif Aktif (Haftada 1-3 gün spor)</x:String>
                                        <x:String>Orta Aktif (Haftada 3-5 gün spor)</x:String>
                                        <x:String>Çok Aktif (Haftada 6-7 gün ağır spor)</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <Grid x:Name="SifrePopup"
      IsVisible="False"
      BackgroundColor="#99000000"
      Padding="30">

                        <Border BackgroundColor="White"
            StrokeThickness="0"
            Padding="20"
            VerticalOptions="Center"
            HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="15">

                                <Label Text="Şifreyi Güncelle"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#08204B"
                   HorizontalOptions="Center"/>

                                <Entry x:Name="EntSifreKullaniciAdi"
                   Placeholder="Kullanıcı adı"
                   TextColor="Black"
                   PlaceholderColor="Gray"/>

                                <Entry x:Name="EntEskiSifre"
                   Placeholder="Eski şifre"
                   IsPassword="True"
                   TextColor="Black"
                   PlaceholderColor="Gray"/>

                                <Entry x:Name="EntYeniSifre"
                   Placeholder="Yeni şifre"
                   IsPassword="True"
                   TextColor="Black"
                   PlaceholderColor="Gray"/>

                                <Button Text="ŞİFREYİ KAYDET"
                    BackgroundColor="#08204B"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnSifreGuncelleClicked"/>

                                <Button Text="İPTAL"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnSifrePenceresiKapatClicked"/>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="GÜNCELLE"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="18"
                            BackgroundColor="#08204B"
                            BorderColor="#3b82f6"
                            BorderWidth="1.5"
                            CornerRadius="8"
                            HeightRequest="50"
                            Margin="40,20,40,25"
                            Clicked="OnGuncelleClicked"/>

                    <Button Text="ŞİFREYİ GÜNCELLE"
        TextColor="White"
        FontAttributes="Bold"
        FontSize="16"
        BackgroundColor="#1E3A8A"
        BorderColor="#3b82f6"
        BorderWidth="1.5"
        CornerRadius="8"
        HeightRequest="48"
        Margin="40,0,40,25"
        Clicked="OnSifrePenceresiAcClicked"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>