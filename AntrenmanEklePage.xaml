<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fitkal.Views.AntrenmanEklePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#051433">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#0A2558" HeightRequest="60" Padding="15,0">
            <HorizontalStackLayout VerticalOptions="Center" Spacing="15">
                <Label Text="←" TextColor="White" FontSize="28" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGeriTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Antrenman Ekle" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" BackgroundColor="#0A2558" Stroke="#1E60D5" StrokeThickness="1" Margin="15,15,15,5" HeightRequest="45">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <SearchBar x:Name="AranacakKelime" 
                       Placeholder="Egzersiz Ara..." 
                       PlaceholderColor="#A0C0F0" 
                       TextColor="White"
                       CancelButtonColor="White"
                       TextChanged="OnAramaDegisti"/>
        </Border>

        <CollectionView x:Name="EgzersizListesi" Grid.Row="2" Margin="15,10" SelectionMode="Single" SelectionChanged="OnEgzersizSecildi">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#0A2558" Stroke="#1E60D5" StrokeThickness="1" Margin="0,0,0,10" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding Ad}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding SaatlikKalori, StringFormat='{0} cal/saat'}" TextColor="#FF7043" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border x:Name="HesaplamaPaneli" Grid.Row="3" IsVisible="False" BackgroundColor="#08204B" Stroke="#1E60D5" StrokeThickness="2" Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">

                <Label x:Name="LblSecilenEgzersiz" Text="Seçilen Egzersiz" TextColor="#F9CA1C" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="1 Saatlik (60 dk) ortalama kalori yakımı:" TextColor="#A0C0F0" FontSize="12" HorizontalOptions="Center" Margin="0,-10,0,0"/>

                <VerticalStackLayout HorizontalOptions="Center" Margin="0,5">
                    <Label x:Name="LblSaatlikKalori" Text="0 cal" TextColor="#FF7043" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#20FFFFFF" Margin="0,5"/>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntDakika" Placeholder="Kaç dakika sürdü?" Keyboard="Numeric" TextColor="Black" HorizontalTextAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="1" Text="EKLE" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8" WidthRequest="100" Clicked="OnAntrenmanEkleClicked"/>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>