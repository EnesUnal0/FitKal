<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fitkal.Views.OgunEklePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#051433">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <Grid Grid.Row="0" BackgroundColor="#0A2558" HeightRequest="60" Padding="15,0">
            <HorizontalStackLayout VerticalOptions="Center" Spacing="15">
                <Label Text="←" TextColor="White" FontSize="28" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGeriTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Yemek Ekle" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" BackgroundColor="#0A2558" Stroke="#1E60D5" StrokeThickness="1" Margin="15,15,15,5" HeightRequest="45">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <SearchBar x:Name="AranacakKelime" 
                       Placeholder="Yemek Ara..." 
                       PlaceholderColor="#A0C0F0" 
                       TextColor="White"
                       CancelButtonColor="White"
                       TextChanged="OnAramaDegisti"/>
        </Border>

        <CollectionView x:Name="YemekListesi" Grid.Row="2" Margin="15,10" SelectionMode="Single" SelectionChanged="OnYemekSecildi">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#0A2558" Stroke="#1E60D5" StrokeThickness="1" Margin="0,0,0,10" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding Ad}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding Kalori, StringFormat='{0} cal'}" TextColor="#A0C0F0" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border x:Name="HesaplamaPaneli" Grid.Row="3" IsVisible="False" BackgroundColor="#08204B" Stroke="#1E60D5" StrokeThickness="2" Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">

                <Label x:Name="LblSecilenYemek" Text="Seçilen Yemek" TextColor="#F9CA1C" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="100 gram içerik bilgisi:" TextColor="#A0C0F0" FontSize="12" HorizontalOptions="Center" Margin="0,-10,0,0"/>

                <Grid ColumnDefinitions="*,*,*,*" HorizontalOptions="Center" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="Pro" TextColor="#8b95a8" FontSize="12"/>
                        <Label x:Name="LblPro" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="Karb" TextColor="#8b95a8" FontSize="12"/>
                        <Label x:Name="LblKarb" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="Yağ" TextColor="#8b95a8" FontSize="12"/>
                        <Label x:Name="LblYag" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                        <Label Text="Şeker" TextColor="#8b95a8" FontSize="12"/>
                        <Label x:Name="LblSek" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#20FFFFFF" Margin="0,5"/>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EntGram" Placeholder="Kaç gram yedin?" Keyboard="Numeric" TextColor="Black" HorizontalTextAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="1" Text="EKLE" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="8" WidthRequest="100" Clicked="OnYemekEkleClicked"/>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>