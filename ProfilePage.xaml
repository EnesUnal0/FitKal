<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:fitkal"
             x:Class="fitkal.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="arka_plan.jpg" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />

        <Grid RowDefinitions="75, *">
            <local:HeaderView Grid.Row="0" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="30,20" Spacing="15">

                    <VerticalStackLayout Spacing="2" Margin="0,0,0,10">
                        <Label x:Name="LblAdSoyadUst" Text="Enes Ünal" TextColor="White" FontSize="28" FontAttributes="Bold"/>
                        <Label x:Name="LblAltBilgi" Text="22, 80 kg, 180 cm" TextColor="#A0C0F0" FontSize="16"/>
                        <Label x:Name="LblHedefKiloUst" Text="Hedef Kg : 75" TextColor="#F9CA1C" FontSize="16" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="AD" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntAd" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="SOYAD" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntSoyad" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="YAŞ" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntYas" Keyboard="Numeric" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="KİLO" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntKilo" Keyboard="Numeric" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="BOY" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntBoy" Keyboard="Numeric" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="HEDEF KİLO" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntHedefKilo" Keyboard="Numeric" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="HEDEF KALORİ" TextColor="#3b82f6" FontAttributes="Bold" FontSize="14" Margin="5,0"/>
                        <Border BackgroundColor="White" StrokeThickness="0" HeightRequest="45" Padding="15,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EntHedefKalori" Keyboard="Numeric" TextColor="Black" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="GÜNCELLE"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="18"
                            BackgroundColor="#08204B"
                            BorderColor="#3b82f6"
                            BorderWidth="1.5"
                            CornerRadius="8"
                            HeightRequest="50"
                            Margin="40,10,40,20"
                            Clicked="OnGuncelleClicked"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>